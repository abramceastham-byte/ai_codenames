# docker build -t registryext.bsprague.com/codenames-ai -f Dockerfile.aisrv .
FROM golang:1.25.4 AS builder

RUN adduser \
  --disabled-password \
  --gecos "" \
  --home "/nonexistent" \
  --shell "/sbin/nologin" \
  --no-create-home \
  --uid 65532 \
  noroot

WORKDIR /build

# Copy dependency files first for caching
COPY go.mod go.sum ./
RUN go mod download && go mod verify

# Copy the rest of the source code
COPY cmd/ai-server/ cmd/ai-server/
COPY codenames/ codenames/
COPY client/ client/
COPY cryptorand/ cryptorand/
COPY httperr/ httperr/
COPY llm/ llm/
COPY msgs/ msgs/
COPY w2v/ w2v/

# Build the binary (statically linked)
RUN CGO_ENABLED=0 GOOS=linux go build -o /aiserver ./cmd/ai-server

FROM alpine:3.22

RUN apk add --no-cache ca-certificates

WORKDIR /app

COPY --from=builder /etc/passwd /etc/passwd
COPY --from=builder /etc/group /etc/group

# Copy the binary
COPY --from=builder /aiserver /aiserver

# Expose the port the app runs on
EXPOSE 8081
USER noroot
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1:8081/healthz || exit 1

# Run the binary
ENTRYPOINT ["/aiserver"]
