# docker build -t codenames-competition -f Dockerfile.websrv .
#
# Builds the SPA and the Go server into one image: the server serves the API,
# the bot WebSocket and the static frontend on a single port, so a deployment
# needs exactly one URL.
FROM node:22-alpine AS frontend

WORKDIR /build/frontend
RUN corepack enable

COPY frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml frontend/.npmrc ./
RUN pnpm install --frozen-lockfile

COPY frontend/ ./
RUN pnpm run build

FROM golang:1.25.4 AS builder

WORKDIR /build

# Dependency files first, so the module cache survives source edits.
COPY go.mod go.sum ./
RUN go mod download && go mod verify

COPY cmd/ cmd/
COPY boardgen/ boardgen/
COPY codenames/ codenames/
COPY cryptorand/ cryptorand/
COPY game/ game/
COPY httperr/ httperr/
COPY hub/ hub/
COPY memdb/ memdb/
COPY msgs/ msgs/
COPY sqldb/ sqldb/
COPY web/ web/

RUN CGO_ENABLED=0 GOOS=linux go build -o /server ./cmd/codenames-server

FROM gcr.io/distroless/static-debian12:nonroot

WORKDIR /app

COPY --from=builder /server /server
COPY --from=frontend /build/frontend/build /app/static

EXPOSE 8080

ENTRYPOINT ["/server"]
